{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build STM32 Project",
            "type": "shell",
            "command": "make",
            "args": [
                "-j4"
            ],
            "options": {
                "cwd": "${workspaceFolder}/STM32CubeIDE"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "Clean STM32 Project",
            "type": "shell",
            "command": "make",
            "args": [
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}/STM32CubeIDE"
            },
            "problemMatcher": []
        },
        {
            "label": "Flash STM32",
            "type": "shell",
            "command": "st-flash",
            "args": [
                "write",
                "${workspaceFolder}/build/*.bin",
                "0x8000000"
            ],
            "problemMatcher": [],
            "dependsOn": "Build STM32 Project"
        }
    ]
}
